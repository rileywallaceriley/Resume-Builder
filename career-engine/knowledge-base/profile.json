      "summary": "Two or three sentence master professional summary.",
      "valuePropositions": [
        "Example value proposition"
      ],
      "targetRoles": [
        "Example role"
      ],
      "yearsExperience": "10+"
    },
    "languages": [
      {
        "language": "Example language",
        "proficiency": "Professional"
      }
    ],
    "workAuthorization": [
      {
        "country": "Example Country",
        "status": "Authorized",
        "sponsorshipRequired": false
      }
    ]
  }
}
