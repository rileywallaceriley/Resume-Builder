    },
    "contact": {
      "email": "",
      "phone": "",
      "website": "",
      "linkedIn": "",
      "otherLinks": []
    },
    "professionalIdentity": {
      "headline": "",
      "summary": "",
      "valuePropositions": [],
      "targetRoles": [],
      "yearsExperience": ""
    },
    "languages": [],
    "workAuthorization": []
  },
  "_template": {
    "_comment": "Stable identity and positioning facts. Keep channel-specific prose elsewhere.",
    "preferredName": "",
    "pronouns": "",
    "location": {
      "city": "",
      "region": "",
      "country": "",
      "timeZone": ""
    },
    "contact": {
      "email": "",
      "phone": "",
      "website": "",
      "linkedIn": "",
      "otherLinks": []
    },
    "professionalIdentity": {
      "headline": "",
      "summary": "",
      "valuePropositions": [],
      "targetRoles": [],
      "yearsExperience": ""
    },
    "languages": [],
    "workAuthorization": []
  },
  "_example": {
