        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skillsDemonstrated": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "favoriteWork": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lessonsLearned": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quotes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "attribution": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "permissionToUse": {
                "type": "boolean"
              }
            },
            "required": [
              "text",
              "attribution",
              "date",
              "permissionToUse"
            ]
          }
        },
        "_comment": {
          "type": "string",
          "description": "Inline documentation; not career data."
        }
      },
      "required": [
        "id",
        "company",
        "title",
        "employmentType",
        "location",
        "workMode",
        "dates",
        "summary",
        "responsibilities",
        "majorWins",
        "metrics",
        "projects",
        "industries",
        "technologies",
        "skillsDemonstrated",
        "stories",
        "favoriteWork",
        "lessonsLearned",
        "quotes",
        "_comment"
      ]
    }
  },
