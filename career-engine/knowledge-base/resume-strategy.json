  "_example": {
    "_comment": "Deterministic resume-generation policy. Values are defaults and may be overridden by an explicit job-specific brief.",
    "maximumPages": {
      "default": 2,
      "executive": 3,
      "earlyCareer": 1
    },
    "preferredEmphasis": [
      "Measurable outcomes",
      "Role-relevant evidence",
      "Recent experience"
    ],
    "whenToShorten": [
      "Remove content that does not support the target role.",
      "Compress older, less relevant roles."
    ],
    "whenToExpand": [
      "Add context when scope is necessary to understand an achievement.",
      "Include more evidence for senior leadership roles."
    ],
    "accomplishmentPrioritization": {
      "orderedCriteria": [
        "Relevance to target role",
        "Magnitude of measurable impact",
        "Recency",
        "Evidence confidence"
      ],
      "minimumConfidence": "medium",
      "maximumBulletsPerRole": 6
    },
    "tailoring": {
      "executiveJobs": [
        "Emphasize enterprise scope, strategy, leadership, and business results."
      ],
      "technicalWriting": [
        "Emphasize complex-domain fluency, audience outcomes, and writing samples."
      ],
      "marketing": [
        "Emphasize audience insight, growth metrics, positioning, and cross-functional execution."
      ]
    },
    "contentRules": [
      "Never invent facts or metrics.",
      "Use only knowledge-base evidence.",
      "Flag conflicts or missing evidence for human review."
    ],
    "formatRules": [
      "Prefer concise accomplishment bullets.",
      "Keep dates and titles consistent with source records."
    ],
    "exclusions": [
      "Sensitive or private fields unless explicitly authorized."
    ]
  }
